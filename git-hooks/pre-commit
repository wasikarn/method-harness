#!/usr/bin/env bash
# pre-commit — fast gate on staged files:
#   shell syntax (+shellcheck if installed), py_compile, JSON parse,
#   hardcoded home-path ban, harness-audit CRIT count.
# Full gauntlet runs in pre-push. Wire once: git config core.hooksPath git-hooks
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
fail=0
staged() { git diff --cached --name-only --diff-filter=ACMR -- "$@"; }
staged_z() { git diff --cached --name-only -z --diff-filter=ACMR; }  # NUL-separated, for xargs -0
# Syntax layers skip the audit's known-bad fixtures: they are invalid on purpose (checks 17,
# 18, 19 must fire on them). The home-path ban still covers them.
staged_lint() { staged "$@" ':(exclude)tests/skills/harness-audit/known-bad'; }
tmp=$(mktemp -d) && [ -d "$tmp" ] || { echo "pre-commit: mktemp -d failed" >&2; exit 1; }
trap '[ -n "$tmp" ] && trash "$tmp" 2>/dev/null; true' EXIT

# 6 (started first). harness-audit is the slowest step and reads the whole tree, so it runs
# in the background beside the staged-file checks; its verdict is read at step 6 below.
AUDIT="skills/meta/harness-audit/scripts/audit.sh"
audit_pid=""
if [ -f "$AUDIT" ]; then
  bash "$AUDIT" . >"$tmp/audit" 2>&1 & audit_pid=$!
fi

# 1. shell syntax
while IFS= read -r f; do
  [ -n "$f" ] || continue
  bash -n "$f" || fail=1
done < <(staged_lint '*.sh' 'git-hooks/*')
if command -v shellcheck >/dev/null; then
  files=$(staged_lint '*.sh' 'git-hooks/*')
  # shellcheck disable=SC2086
  [ -z "$files" ] || shellcheck -S warning $files || fail=1
fi

# 2+3. py_compile + JSON parse, one python process for all staged files
files=$(staged_lint '*.py' '*.json')
if [ -n "$files" ]; then
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 python3 scripts/_lib/lint-files.py --prefix 'pre-commit: ' || fail=1
fi

# 4. hardcoded home paths (repo is public); frozen history dirs are exempt from wording passes,
#    never from this (CLAUDE.md, repo-gotchas.md: a 2026-08-26 purge missed 29 hits there)
#    One git grep over the index copies of every staged file (-a: binary files too), not one git show each.
while IFS= read -r -d '' f; do
  echo "pre-commit: hardcoded home path in $f — use \$HOME or ~" >&2
  fail=1
done < <(staged_z | LC_ALL=C xargs -0 -r git --literal-pathspecs grep --cached -z -a -l -E '/Users/[A-Za-z]|-Users-[A-Za-z]' --)

# 5. METHODOLOGY.md is injected whole every session: hard cap 4096 bytes
if staged docs/METHODOLOGY.md | /usr/bin/grep -q .; then
  n=$(git show :docs/METHODOLOGY.md | wc -c | tr -d ' ')
  [ "$n" -le 4096 ] || { echo "pre-commit: docs/METHODOLOGY.md is ${n}B, cap 4096" >&2; fail=1; }
fi

# 5b. gate canary: every staged gate must still ALLOW a benign payload with no
# traceback (scripts/gate-canary.sh). A NameError/apostrophe/import slip in a
# gate blocks every Bash call machine-wide (2026-09-05 incident). Runs on the
# INDEX copy of hooks/gates, not the working tree, so a partial stage on a
# shared tree tests what is actually being committed.
# Narrowed: a staged gate X.sh or its X.py canaries X.sh alone; any other staged file under
# hooks/gates (a shared helper such as _journal.py, or a file with no sibling X.sh) canaries every gate;
# a newly added X.sh is in the index copy, so it canaries itself.
gates_staged=$(staged 'hooks/gates/*')
if [ -n "$gates_staged" ]; then
  idx="$tmp/idx"
  git ls-files -z hooks/gates | xargs -0 git checkout-index --prefix="$idx/" --
  only=()
  while IFS= read -r f; do
    b="${f#hooks/gates/}" n="${b%.*}"
    case "$b" in */*|_*) only=(); break ;; esac # a _* helper is sourced by several gates: canary all
    # shortcut: assumes a gate's X.py is imported only by X.sh (shared code lives in _*.py or
    # brace-route.awk); if a gate starts importing another gate's .py, canary every gate.
    case " ${only[*]-} " in *" $n.sh "*) continue ;; esac
    case "$b" in *.sh|*.py) [ -f "$idx/hooks/gates/$n.sh" ] && { only+=("$n.sh"); continue; } ;; esac
    only=(); break
  done <<<"$gates_staged"
  # Empty $only = every gate; the +-guard keeps bash 3.2 quiet about an empty array under set -u.
  bash scripts/gate-canary.sh "$idx/hooks/gates" ${only[@]+"${only[@]}"} || { echo "pre-commit: gate canary blocked (see above)" >&2; fail=1; }
fi

# 6. harness-audit: zero CRITICAL (started in the background at the top)
if [ -n "$audit_pid" ]; then
  wait "$audit_pid"; audit_rc=$?
  out=$(cat "$tmp/audit")
  if [ "$audit_rc" -ne 0 ]; then
    echo "pre-commit: harness-audit CRIT findings:" >&2
    printf '%s\n' "$out" | /usr/bin/grep 'CRIT F' >&2
    fail=1
  else
    # A passing audit prints nothing; surface the new-component INFO so the plugin-update reminder is seen.
    printf '%s\n' "$out" | /usr/bin/grep 'is new vs' | sed 's/^/pre-commit: /' >&2 || true
  fi
else
  echo "pre-commit: WARN $AUDIT missing, skipping harness-audit" >&2
fi

[ "$fail" -eq 0 ] || { echo "pre-commit: blocked" >&2; exit 1; }
exit 0
