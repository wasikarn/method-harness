# OS noise
.DS_Store

# Python
__pycache__/
*.pyc


# Session / skill workspaces
*-workspace/
skills/*/workspace/

# Personal scratch + temp artifacts
.scratch/
*.log
*.tmp
*.bak

# A test that ran with HOME unset once wrote metrics into the repo (2026-08-28);
# never let that reach git again.
.local/

# Machine-specific caches (never ship a stale local blob)
.code-review-graph/

# Owner's per-repo autonomy arming — self-contained in-repo (not leaning on the
# owner's global ~/.config/git/ignore). A foreign clone never inherits an armed
# state, and `git add -A` never stages a local settings file.
.claude/settings.local.json

# graphify: generated architecture-graph snapshot. Goes stale within hours of any
# commit (nothing auto-rebuilds it) — regenerate on demand with `/graphify .`
# rather than trusting a checked-in copy.
graphify-out/

# claude plugin eval runs (evals/README.md)
evals/results/

# Stray top-level scratch entries from throwaway sandbox trials (nested git
# repos used to trial third-party plugins in isolation) — never repo content.
/bar/
/sandbox/

# Claude Code worktree-per-session support (2026-09-28): confirmed live via
# EnterWorktree/ExitWorktree that CC creates linked worktrees under this path.
.claude/worktrees/
